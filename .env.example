# Copy to .env and fill in. Never commit .env.
CLOCKED_API_KEY=your-clocked-api-key
# live (default when a key is set) | replay (offline, recorded fixtures) | record
BULKHEAD_MODE=live
# Optional: stop calling Clocked after this many credits (local ledger in .bulkhead/credits.jsonl)
BULKHEAD_CREDIT_BUDGET=2000
# What to do when Clocked cannot answer (429 after retries, 5xx, 402): ask | deny | allow
BULKHEAD_FAIL_MODE=ask
